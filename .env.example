# Used by docker-compose.yml. Every value has a default, so copying this file is optional.

POSTGRES_DB=school_visits
POSTGRES_USER=school_visits
POSTGRES_PASSWORD=school_visits

DJANGO_SECRET_KEY=change-me-in-any-shared-environment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

SEED_ON_START=true

BACKEND_PORT=8000
FRONTEND_PORT=3000
