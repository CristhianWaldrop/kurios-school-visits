# Local (non-Docker) configuration. Copy to backend/.env.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=insecure-local-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# SQLite by default so the project runs without PostgreSQL.
# Point it at PostgreSQL if you have one:
# DATABASE_URL=postgres://school_visits:school_visits@localhost:5432/school_visits
DATABASE_URL=sqlite:///db.sqlite3
